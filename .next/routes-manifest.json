{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/emergency-contacts",
      "regex": "^/emergency\\-contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/emergency\\-contacts(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/first-aid",
      "regex": "^/first\\-aid(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/first\\-aid(?:/)?$"
    },
    {
      "page": "/hospital-list",
      "regex": "^/hospital\\-list(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hospital\\-list(?:/)?$"
    },
    {
      "page": "/specialist-doctors",
      "regex": "^/specialist\\-doctors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/specialist\\-doctors(?:/)?$"
    },
    {
      "page": "/symptom-diagnosis",
      "regex": "^/symptom\\-diagnosis(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/symptom\\-diagnosis(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}